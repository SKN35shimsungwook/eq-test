# 로컬: 이 파일을 secrets.toml로 복사해 값을 채우세요. secrets.toml은 커밋되지 않습니다.
# 배포: Streamlit Cloud 앱 설정 → Secrets 칸에 같은 내용을 붙여 넣습니다.

# 관리자 분석 페이지 비밀번호 (충분히 길게, 다른 곳에서 쓰지 않는 값)
admin_password = "change-me"

# Supabase(Postgres). 없으면 data/eq_test.db(SQLite)를 쓰는데, Streamlit Cloud에서는 재시작할 때 사라집니다.
# Supabase 대시보드 → Connect → "Session pooler" 주소를 쓰세요 (Streamlit Cloud는 IPv4만 되어 Direct 연결 불가).
# 앞부분을 postgresql+psycopg2:// 로 바꾸고, 비밀번호에 특수문자가 있으면 URL 인코딩합니다 (@ → %40 등).
# [connections.sql]
# url = "postgresql+psycopg2://postgres.<프로젝트 ref>:<DB 비밀번호>@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require"
